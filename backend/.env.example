NODE_ENV=production
PORT=3000
# Coolify production: paste the PostgreSQL resource's private Internal URL here.
# DATABASE_URL=postgres://user:password@database-container:5432/pern_ecommerce
# Or configure the individual PG* variables below.
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_the_generated_database_password
PGDATABASE=pern_ecommerce
JWT_SECRET=replace_with_a_long_random_secret
